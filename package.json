{
  "name": "zhuzhu-xiaohua-fitness-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "tsx scripts/check-integrations.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.17",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@hono/node-server": "2.1.1",
    "@sinclair/typebox": "0.34.52",
    "hono": "4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "sharp": "0.35.4",
    "typebox": "1.3.24"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
